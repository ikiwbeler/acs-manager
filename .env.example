# ACS Manager — environment
# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env ke git.

# Secret untuk menandatangani JWT login UI GenieACS.
# WAJIB diganti dengan string acak panjang. Generate contoh:
#   openssl rand -hex 24
GENIEACS_UI_JWT_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG

# Host container MongoDB (default sesuai docker-compose).
GENIEACS_MONGO_HOST=genieacs-mongo
